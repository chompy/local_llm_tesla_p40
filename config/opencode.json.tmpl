{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": "allow"
  },
  "disabled_providers": [
    "openai",
    "gemini",
    "opencode"
  ],
  "plugin": [
    "opencode-plugin-llama.cpp@latest"
  ],
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "provider": {
    "llama-server": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-server (local)",
      "options": {
        "baseURL": "http://localhost:5800"
      },
      "models": {}
    }
  }
}
